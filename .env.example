# ============================================================
#  payroll-system environment variables
#  Copy to .env and fill in real values
# ============================================================

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---------- Redis (Upstash) ----------
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_UPSTASH.upstash.io:6379

# ---------- JWT ----------
JWT_SECRET=replace-with-a-32-byte-random-hex-string

# ---------- AES Encryption (bank accounts, ID numbers) ----------
AES_KEY=replace-with-a-32-byte-random-hex-string

# ---------- Frontend (Vercel) ----------
REACT_APP_API_URL=https://YOUR_PROJECT_REF.functions.supabase.co
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ---------- GitHub Actions Secrets (set in repo settings) ----------
# SUPABASE_PROJECT_REF
# SUPABASE_TOKEN
# VERCEL_TOKEN
# VERCEL_ORG_ID
# VERCEL_PROJECT_ID
